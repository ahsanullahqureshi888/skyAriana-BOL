{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/safety_gate.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "post-edit-audit": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/post_edit_audit.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
