{
  "name": "sky-ariana-bol",
  "productName": "Sky Ariana BOL",
  "version": "3.2.0",
  "description": "Sky Ariana logistics, Bill of Lading, documents, invoicing, and ledger desktop workspace",
  "author": "AHSANULLAH QURESHI",
  "copyright": "Copyright © AHSANULLAH QURESHI",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "electron:dev": "concurrently -k -s first \"npm:dev\" \"npm:electron:dev:launch\"",
    "electron:dev:launch": "wait-on http://127.0.0.1:3001 && cross-env ELECTRON_START_URL=http://127.0.0.1:3001 npm run build:electron && electron .",
    "build": "next build --webpack",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "next start -p 3001",
    "build:local": "node scripts/local-production.cjs build",
    "start:local": "node scripts/local-production.cjs start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint app components hooks lib electron --max-warnings=0",
    "test": "node --test tests/*.test.cjs && npm run typecheck",
    "electron:build": "npm run build:local && npm run build:electron",
    "dist": "npm run electron:build && electron-builder --win nsis --x64",
    "dist:dir": "npm run electron:build && electron-builder --dir --win --x64",
    "dist:local-installer": "npm run electron:build && node scripts/prepare-desktop-package.cjs && electron-builder --project .desktop-package --dir --win --x64 && node scripts/stamp-windows-exe.cjs && node scripts/build-squirrel.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@types/pg": "^8.20.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "browserslist": "^4.28.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "date-fns-jalali": "4.4.0-0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.6.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "input-otp": "1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.564.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.21.0",
    "react": "^19",
    "react-day-picker": "9.13.2",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "39.8.10",
    "electron-builder": "^26.15.0",
    "electron-winstaller": "^5.4.0",
    "eslint": "9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.44.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.skyariana.bol",
    "productName": "Sky Ariana BOL",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next-production/standalone",
        "to": "app-server"
      },
      {
        "from": ".next-production/static",
        "to": "app-server/.next-production/static"
      },
      {
        "from": "public",
        "to": "app-server/public",
        "filter": [
          "**/*",
          "!uploads/**/*",
          "!test-ledger.pdf"
        ]
      },
      {
        "from": "public/icon-512x512.png",
        "to": "app-icon.png"
      },
      {
        "from": ".",
        "to": "seed-data",
        "filter": [
          ".local-*.json",
          ".bol-counter",
          ".invoice-counter"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon-512x512.png",
      "artifactName": "Sky-Ariana-BOL-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sky Ariana BOL",
      "uninstallDisplayName": "Sky Ariana BOL"
    }
  }
}
